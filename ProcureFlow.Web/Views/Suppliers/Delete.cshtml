@model ProcureFlow.Web.Models.Supplier

@{
    ViewData["Title"] = "Delete supplier";
}

<h1>Delete supplier</h1>
<div class="alert alert-warning">Are you sure you want to delete this supplier?</div>

<dl class="row">
    <dt class="col-sm-3">Supplier name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">VAT / OIB number</dt>
    <dd class="col-sm-9">@(Model.VatNumber ?? "—")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete supplier</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
