@model IEnumerable<ProcureFlow.Web.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Suppliers</h1>
        <p class="text-muted mb-0">Manage supplier contact information.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add supplier</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Supplier</th>
                <th>VAT / OIB</th>
                <th>Contact person</th>
                <th>Email</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td class="fw-semibold">@supplier.Name</td>
                    <td>@(supplier.VatNumber ?? "—")</td>
                    <td>@(supplier.ContactPerson ?? "—")</td>
                    <td>@(supplier.Email ?? "—")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No suppliers yet. Add your first supplier to get started.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
