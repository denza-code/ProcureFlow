@model ProcureFlow.Web.Models.CatalogItem
@using ProcureFlow.Web.Helpers

@{
    ViewData["Title"] = "Delete catalog item";
}

<h1>Delete catalog item</h1>
<div class="alert alert-warning">Are you sure you want to delete this catalog item?</div>

<dl class="row">
    <dt class="col-sm-3">Item name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Estimated unit price</dt>
    <dd class="col-sm-9">@CurrencyFormatter.ToEuro(Model.EstimatedUnitPrice)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete catalog item</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
