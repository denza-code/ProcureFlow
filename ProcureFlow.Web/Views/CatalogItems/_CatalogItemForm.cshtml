@model ProcureFlow.Web.Models.CatalogItem

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ItemCode" class="form-label"></label>
    <input asp-for="ItemCode" class="form-control" />
    <span asp-validation-for="ItemCode" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-7 mb-3">
        <label asp-for="EstimatedUnitPrice" class="form-label"></label>
        <input asp-for="EstimatedUnitPrice" class="form-control" placeholder="Example: 29,99" />
        <span asp-validation-for="EstimatedUnitPrice" class="text-danger"></span>
    </div>
    <div class="col-md-5 mb-4">
        <label asp-for="UnitOfMeasure" class="form-label"></label>
        <input asp-for="UnitOfMeasure" class="form-control" />
        <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
    </div>
</div>
