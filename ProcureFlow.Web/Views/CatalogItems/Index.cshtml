@model IEnumerable<ProcureFlow.Web.Models.CatalogItem>
@using ProcureFlow.Web.Helpers

@{
    ViewData["Title"] = "Catalog items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Catalog items</h1>
        <p class="text-muted mb-0">Products and services available for purchase requests.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add catalog item</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Item</th>
                <th>Code</th>
                <th>Unit of measure</th>
                <th class="text-end">Estimated unit price</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@(item.ItemCode ?? "—")</td>
                    <td>@item.UnitOfMeasure</td>
                    <td class="text-end">@CurrencyFormatter.ToEuro(item.EstimatedUnitPrice)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No catalog items yet. Add the first item for future purchase requests.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
