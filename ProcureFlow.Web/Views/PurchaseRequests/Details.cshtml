@model ProcureFlow.Web.Models.PurchaseRequest
@using ProcureFlow.Web.Helpers
@using ProcureFlow.Web.Models.Enums
@using ProcureFlow.Web.Security

@{
    ViewData["Title"] = "Purchase request";
    var canManageDraft = Model.Status == PurchaseRequestStatus.Draft &&
        (User.IsInRole(AppRoles.Admin) || User.Identity?.Name == Model.RequesterUser?.Email);
    var canDecide = Model.Status == PurchaseRequestStatus.Submitted &&
        (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Admin));
    var estimatedTotal = Model.Items.Sum(item => item.EstimatedTotal);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-1">@Model.RequestNumber</p>
        <h1 class="mb-1">@Model.Title</h1>
        <span class="badge @GetStatusClass(Model.Status)">@Model.Status</span>
    </div>
    <div>
        @if (canManageDraft)
        {
            <a asp-action="AddItem" asp-route-requestId="@Model.Id" class="btn btn-outline-primary">Add item</a>
        }
        @if (Model.Status == PurchaseRequestStatus.Approved && User.IsInRole(AppRoles.Admin))
        {
            <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-requestId="@Model.Id" class="btn btn-primary">Create purchase order</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to requests</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <section class="border rounded p-3 h-100">
            <h2 class="h5">Business justification</h2>
            <p class="mb-0">@Model.BusinessJustification</p>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="border rounded p-3 h-100">
            <h2 class="h5">Request details</h2>
            <dl class="mb-0">
                <dt>Requester</dt>
                <dd>@(Model.RequesterUser?.Email ?? "—")</dd>
                <dt>Created</dt>
                <dd>@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                @if (Model.SubmittedAtUtc is not null)
                {
                    <dt>Submitted</dt>
                    <dd>@Model.SubmittedAtUtc.Value.ToLocalTime().ToString("g")</dd>
                }
            </dl>
        </section>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Request items</h2>
    <strong>Estimated total: @CurrencyFormatter.ToEuro(estimatedTotal)</strong>
</div>

<div class="table-responsive mb-4">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Catalog item</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Estimated unit price</th>
                <th class="text-end">Estimated total</th>
                @if (canManageDraft)
                {
                    <th class="text-end">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.CatalogItem?.Name ?? "—")</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@CurrencyFormatter.ToEuro(item.EstimatedUnitPrice)</td>
                    <td class="text-end">@CurrencyFormatter.ToEuro(item.EstimatedTotal)</td>
                    @if (canManageDraft)
                    {
                        <td class="text-end">
                            <form asp-action="RemoveItem" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No items added yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (canManageDraft)
{
    <form asp-action="Submit" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Submit for approval</button>
    </form>
}

@if (canDecide)
{
    <div class="d-flex gap-2">
        <form asp-action="Approve" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Approve</button>
        </form>
        <a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-outline-danger">Reject</a>
    </div>
}

@if (Model.Status == PurchaseRequestStatus.Rejected)
{
    <div class="alert alert-danger mt-4">
        <strong>Rejection reason:</strong> @Model.DecisionNote
    </div>
}
else if (Model.Status == PurchaseRequestStatus.Approved)
{
    <div class="alert alert-success mt-4">This request was approved.</div>
}

@functions {
    string GetStatusClass(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => "request-status request-status-draft",
        PurchaseRequestStatus.Submitted => "request-status request-status-submitted",
        PurchaseRequestStatus.Approved => "request-status request-status-approved",
        PurchaseRequestStatus.Rejected => "request-status request-status-rejected",
        _ => "request-status request-status-draft"
    };
}
