@model ProcureFlow.Web.ViewModels.CreatePurchaseRequestViewModel

@{
    ViewData["Title"] = "New purchase request";
}

<h1>New purchase request</h1>
<p class="text-muted">Create a draft, then add one or more catalog items before submitting it for approval.</p>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Example: Equipment for a new employee" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="BusinessJustification" class="form-label"></label>
                <textarea asp-for="BusinessJustification" class="form-control" rows="5" placeholder="Explain the business need and expected benefit."></textarea>
                <span asp-validation-for="BusinessJustification" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Create draft</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
