@using Microsoft.AspNetCore.Identity
@using ProcureFlow.Web.Security
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link app-nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@User.Identity?.Name</a>
    </li>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <li class="nav-item"><span class="role-badge role-admin">Admin</span></li>
    }
    else if (User.IsInRole(AppRoles.Manager))
    {
        <li class="nav-item"><span class="role-badge role-manager">Manager</span></li>
    }
    else if (User.IsInRole(AppRoles.Employee))
    {
        <li class="nav-item"><span class="role-badge role-employee">Employee</span></li>
    }
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link app-nav-link btn btn-link border-0">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link app-nav-link" asp-area="Identity" asp-page="/Account/Login">Demo login</a>
    </li>
}
</ul>
