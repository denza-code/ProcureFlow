<!DOCTYPE html>
@{
    var applicationInsightsConnectionString = Configuration["APPLICATIONINSIGHTS_CONNECTION_STRING"];
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProcureFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProcureFlow.Web.styles.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(applicationInsightsConnectionString))
    {
        <script src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js" crossorigin="anonymous"></script>
        <script>
            (() => {
                const snippet = {
                    config: {
                        connectionString: @Html.Raw(JsonSerializer.Serialize(applicationInsightsConnectionString))
                    }
                };
                const telemetry = new Microsoft.ApplicationInsights.ApplicationInsights(snippet);
                telemetry.loadAppInsights();
                telemetry.trackPageView();
            })();
        </script>
    }
</head>
<body class="app-shell">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">PF</span>
                    <span>ProcureFlow</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseRequests" ? "active" : "")" asp-controller="PurchaseRequests" asp-action="Index">Purchase requests</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CatalogItems" ? "active" : "")" asp-controller="CatalogItems" asp-action="Index">Catalog</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseOrders" ? "active" : "")" asp-controller="PurchaseOrders" asp-action="Index">Purchase orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "")" asp-controller="Invoices" asp-action="Index">Invoices</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 ProcureFlow &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
