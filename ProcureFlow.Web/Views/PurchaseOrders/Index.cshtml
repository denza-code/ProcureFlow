@model IEnumerable<ProcureFlow.Web.Models.PurchaseOrder>
@using ProcureFlow.Web.Helpers
@using ProcureFlow.Web.Models.Enums

@{
    ViewData["Title"] = "Purchase orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Purchase orders</h1>
        <p class="text-muted mb-0">Create and track supplier orders from approved requests.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create purchase order</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Order</th><th>Purchase request</th><th>Supplier</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="fw-semibold">@order.OrderNumber</td>
                    <td>@(order.PurchaseRequest?.RequestNumber ?? "—")</td>
                    <td>@(order.Supplier?.Name ?? "—")</td>
                    <td><span class="badge @GetStatusClass(order.Status)">@order.Status</span></td>
                    <td class="text-end">@CurrencyFormatter.ToEuro(order.Items.Sum(item => item.Total))</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Details</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No purchase orders created yet.</td></tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string GetStatusClass(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => "order-status order-status-draft",
        PurchaseOrderStatus.Sent => "order-status order-status-sent",
        PurchaseOrderStatus.Received => "order-status order-status-received",
        PurchaseOrderStatus.Cancelled => "order-status order-status-cancelled",
        _ => "order-status order-status-draft"
    };
}
